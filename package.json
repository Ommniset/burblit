{
  "name": "burblit",
  "version": "1.0.0",
  "description": "E2EE web messaging prototype",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json && esbuild src/client/main.ts --bundle --outfile=public/bundle.js --format=iife --target=es2020 --sourcemap",
    "watch:client": "esbuild src/client/main.ts --bundle --outfile=public/bundle.js --format=iife --target=es2020 --sourcemap --watch",
    "start": "node dist/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ommniset/burblit.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Ommniset/burblit/issues"
  },
  "homepage": "https://github.com/Ommniset/burblit#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "libsodium-wrappers": "^0.8.4",
    "libsodium-wrappers-sumo": "^0.8.4",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^25.8.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
